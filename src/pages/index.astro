---
import Base from '../layouts/Base.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import tools from '../data/tools.json';
import categories from '../data/categories.json';

const counts = Object.fromEntries(categories.map((c) => [c.slug, tools.filter((t) => t.category === c.slug).length]));
---

<Base>
  <section class="mb-12 text-center">
    <h1 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
      Find the right AI for
      <span class="bg-gradient-to-r from-violet-600 to-cyan-600 bg-clip-text text-transparent dark:from-violet-400 dark:to-cyan-400">every game-dev task</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-ink-muted">
      A curated directory of AI tools for game developers — filtered by task, tagged by engine, and marked when human-tested. No pay-to-rank.
    </p>

    <div class="mx-auto mt-8 max-w-xl">
      <input
        id="search"
        type="search"
        placeholder={`Search ${tools.length} tools… e.g. skybox, voice, QA`}
        class="w-full rounded-xl border border-edge bg-card px-4 py-3 text-ink placeholder-ink-faint outline-none focus:border-violet-500"
      />
    </div>

    <p class="mt-3 text-sm text-ink-faint">
      <span id="tool-count">{tools.length}</span> tools · {categories.length} task categories · 100% independent
    </p>
  </section>

  <section id="categories" class="mb-12 scroll-mt-20">
    <h2 class="mb-4 text-xl font-bold">Browse by task</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((cat) => <CategoryCard cat={cat} count={counts[cat.slug] ?? 0} />)}
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-bold">All tools</h2>
    <div id="tool-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <ToolCard tool={tool} />)}
    </div>
    <p id="empty" class="hidden py-10 text-center text-ink-faint">
      No tools match — try another keyword, or <a href="/submit" class="text-violet-600 underline dark:text-violet-400">submit one</a>.
    </p>
  </section>

  <script>
    const input = document.getElementById('search');
    const cards = Array.from(document.querySelectorAll('[data-tool]'));
    const countEl = document.getElementById('tool-count');
    const emptyEl = document.getElementById('empty');

    input?.addEventListener('input', () => {
      const v = input.value.trim().toLowerCase();
      let n = 0;
      for (const card of cards) {
        const hit = !v || (card.getAttribute('data-search') ?? '').includes(v);
        card.classList.toggle('hidden', !hit);
        if (hit) n++;
      }
      if (countEl) countEl.textContent = String(n);
      emptyEl?.classList.toggle('hidden', n > 0);
    });
  </script>
</Base>
