---
import Base from '../../layouts/Base.astro';
import ToolCard from '../../components/ToolCard.astro';
import Comments from '../../components/Comments.astro';
import tools from '../../data/tools.json';
import categories from '../../data/categories.json';

interface Tool {
  name: string;
  url: string;
  repo?: string;
  category: string;
  pricing: string;
  engines: string[];
  tested: boolean;
  oneLiner: string;
  rating?: number;
  verdict?: string;
}

export function getStaticPaths() {
  return (tools as Tool[]).map((tool) => ({
    params: { slug: tool.name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const cat = categories.find((c) => c.slug === tool.category);
const similar = (tools as Tool[]).filter((t) => t.category === tool.category && t.name !== tool.name).slice(0, 3);
const stars = tool.rating != null ? '★'.repeat(Math.round(tool.rating)) + '☆'.repeat(5 - Math.round(tool.rating)) : null;
---

<Base title={`${tool.name} — ${cat?.label ?? 'AI tool'} for game devs`} description={tool.oneLiner}>
  <nav class="mb-6 text-sm text-ink-faint">
    <a href="/" class="hover:text-ink">Home</a> <span class="mx-1">/</span>
    <a href={`/category/${cat?.slug}`} class="hover:text-ink">{cat?.label}</a> <span class="mx-1">/</span>
    <span class="text-ink-muted">{tool.name}</span>
  </nav>

  <header class="mb-8 flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-extrabold tracking-tight">{tool.name}</h1>
      <span class={`rounded-full border px-2.5 py-1 text-xs ${tool.tested ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' : 'border-chip-border bg-chip text-ink-muted'}`}>
        {tool.tested ? '✅ Human-tested' : '⏳ Not tested yet'}
      </span>
    </div>
    <p class="max-w-2xl text-lg text-ink-muted">{tool.oneLiner}</p>
    <div class="flex flex-wrap gap-2 text-xs">
      <span class="rounded-full border border-chip-border bg-chip px-2.5 py-1 capitalize text-ink">{tool.pricing}</span>
      {tool.engines.map((e) => (
        <span class="rounded-full border border-chip-border bg-chip px-2.5 py-1 text-ink">{e === 'any' ? 'engine-agnostic' : e}</span>
      ))}
    </div>
    {(stars || tool.verdict) && (
      <div class="max-w-2xl rounded-xl border border-edge bg-card p-4">
        <p class="flex items-center gap-2 text-sm font-semibold">
          <span>Curator's take</span>
          {stars && <span class="tracking-widest text-amber-500">{stars}</span>}
          {tool.rating != null && <span class="text-ink-faint">{tool.rating.toFixed(1)}/5</span>}
        </p>
        {tool.verdict && <p class="mt-2 text-sm text-ink-muted">{tool.verdict}</p>}
      </div>
    )}

    <div class="flex w-fit flex-wrap items-center gap-3">
      <a
        href={tool.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500"
      >
        Visit {tool.name} →
      </a>
      {tool.repo && (
        <a
          href={tool.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-edge px-5 py-2.5 font-semibold text-ink transition hover:border-violet-500/50"
        >
          GitHub ↗
        </a>
      )}
    </div>
  </header>

  {similar.length > 0 && (
    <section>
      <h2 class="mb-4 text-lg font-bold">Similar tools in {cat?.label}</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {similar.map((t) => <ToolCard tool={t} />)}
      </div>
    </section>
  )}

  <Comments />

  <p class="mt-10 border-t border-edge pt-6 text-sm text-ink-faint">
    Listings on this site are free and unpaid. Ranking is never influenced by payment.
  </p>
</Base>
