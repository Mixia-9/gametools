---
import Base from '../layouts/Base.astro';
---

<Base title="Submit a tool — AI Tools for Game Devs">
  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight">Submit a tool</h1>
    <p class="mt-4 text-ink-muted">
      Building an AI tool for game developers? Get listed for free. Include: name, URL, one-line description,
      pricing model (free / freemium / paid) and supported engines (Unity / Unreal / Godot / engine-agnostic).
    </p>

    <div class="mt-8 rounded-xl border border-edge bg-card p-6">
      <h2 class="font-semibold">How it works</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-muted">
        <li>✅ Free submissions are reviewed within 2–4 weeks.</li>
        <li>🏷️ Listings are editorial and never pay-to-rank.</li>
        <li>🧪 Tools we test ourselves get a “Tested” badge and a short review.</li>
      </ul>
    </div>

    <!-- TODO: 替换为你的 Tally 表单（tally.so 免费建表，把 embed 代码贴到这里） -->
    <div class="mt-8 rounded-xl border border-dashed border-edge p-8 text-center text-sm text-ink-faint">
      Submission form placeholder —
      <a href="mailto:you@example.com" class="text-violet-600 underline dark:text-violet-400">email us</a>
      meanwhile.
    </div>
  </div>
</Base>
