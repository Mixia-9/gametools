---
import '../styles/global.css';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import { locales, htmlLang, localePath, stripLocale, t, type Locale } from '../i18n/ui';

interface Props {
  title?: string;
  description?: string;
  locale?: Locale;
}

const SITE = 'https://www.gametools.info';

const { locale = 'en', title = t(locale, 'title.default'), description = t(locale, 'hero.sub') } = Astro.props;

const canonicalPath = stripLocale(Astro.url.pathname);
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={SITE + localePath(locale, canonicalPath)} />
    {locales.map((l) => <link rel="alternate" hreflang={htmlLang[l]} href={SITE + localePath(l, canonicalPath)} />)}
    <link rel="alternate" hreflang="x-default" href={SITE + localePath('en', canonicalPath)} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>" />
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var dark = saved ? saved === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-page text-ink antialiased">
    <header class="sticky top-0 z-10 border-b border-edge/80 bg-page/80 backdrop-blur">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-3 px-4 py-3">
        <a href={localePath(locale, '/')} class="flex items-center gap-2 font-bold tracking-tight">
          <span class="text-lg">🎮</span>
          <span>Game<span class="text-violet-600 dark:text-violet-400">Tools</span></span>
        </a>
        <div class="flex items-center gap-4">
          <nav class="hidden items-center gap-4 text-sm text-ink-muted md:flex">
            <a href={localePath(locale, '/#categories')} class="hover:text-ink">{t(locale, 'nav.categories')}</a>
            <a href={localePath(locale, '/submit')} class="hover:text-ink">{t(locale, 'nav.submit')}</a>
            <a href={localePath(locale, '/about')} class="hover:text-ink">{t(locale, 'nav.about')}</a>
          </nav>
          <LanguageSwitcher locale={locale} path={canonicalPath} />
          <button
            id="theme-toggle"
            aria-label={t(locale, 'theme.aria')}
            class="rounded-lg border border-edge p-2 text-ink-muted transition hover:border-violet-500/50 hover:text-ink"
          >
            <svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round" />
            </svg>
            <svg class="h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-10">
      <slot />
    </main>

    <footer class="border-t border-edge/80">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-8 text-sm text-ink-faint sm:flex-row sm:items-center sm:justify-between">
        <p>{t(locale, 'footer.note')}</p>
        <p>© 2026 GameTools · gametools.info</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('theme-toggle');
      btn?.addEventListener('click', (e) => {
        const root = document.documentElement;
        const dark = !root.classList.contains('dark');
        localStorage.setItem('theme', dark ? 'dark' : 'light');

        const apply = () => {
          root.classList.toggle('dark', dark);
          // 同步 Giscus 评论框主题：已加载则发消息，未加载则改属性待其初始化时生效
          const frame = document.querySelector('iframe.giscus-frame');
          if (frame) {
            frame.contentWindow?.postMessage(
              { giscus: { setConfig: { theme: dark ? 'dark' : 'light' } } },
              '*'
            );
          } else {
            document.getElementById('giscus-script')?.setAttribute('data-theme', dark ? 'dark' : 'light');
          }
        };

        if (!document.startViewTransition || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          apply();
          return;
        }

        const x = e.clientX;
        const y = e.clientY;
        const endRadius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

        const transition = document.startViewTransition(apply);
        transition.ready.then(() => {
          root.animate(
            { clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${endRadius}px at ${x}px ${y}px)`] },
            { duration: 450, easing: 'ease-in-out', pseudoElement: '::view-transition-new(root)' }
          );
        });
      });
    </script>
  </body>
</html>
