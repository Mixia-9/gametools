---
import { locales, localeNames, localePath, t, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** 不含语言前缀的规范路径 */
  path: string;
}

const { locale, path } = Astro.props;
---

<nav aria-label={t(locale, 'lang.aria')} class="flex items-center gap-2 text-xs">
  {
    locales.map((l, i) => (
      <>
        {i > 0 && <span class="text-ink-faint">·</span>}
        <a
          href={localePath(l, path)}
          aria-current={l === locale ? 'page' : undefined}
          class={l === locale ? 'font-semibold text-ink' : 'text-ink-faint transition hover:text-ink'}
        >
          {localeNames[l]}
        </a>
      </>
    ))
  }
</nav>
