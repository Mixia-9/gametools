---
// 「重生之我是英雄联盟职业选手」——文字生涯模拟游戏（目前只有简体中文）
---
<div id="lol-pro" class="lol-pro"></div>

<script>
  import { ATTRS, POSITIONS, POS_ORDER, QUALITY, REGIONS, TRAITS, type Attr, type Position, type ProPlayer, type Region } from '../../games/lol/data';
  import * as E from '../../games/lol/engine';

  type GameState = E.GameState;
  type Ui = {
    view: 'main' | 'teams' | 'gacha' | 'pick';
    pool: E.Pool;
    last: ProPlayer[];
    notice: string;
    pick: { region: Region; pos: Position; trait: string };
    /** 开始画面两个输入框的内容 */
    name: string;
    team: string;
    /** 战队面板里哪些队伍是展开的 */
    open: Record<string, boolean>;
    /** 抽卡面板里选中的那张卡（替补席上的选手 ID） */
    sel: string | null;
  };

  const VIEW_KEY = 'gametools-lol-view';
  /** 刷新页面后回到刚才所在的面板：开发时页面会自动刷新，不能把人踢回主界面 */
  function savedView(): Ui['view'] {
    try {
      const v = sessionStorage.getItem(VIEW_KEY);
      return v === 'teams' || v === 'gacha' || v === 'pick' ? v : 'main';
    } catch {
      return 'main';
    }
  }

  const root = document.getElementById('lol-pro') as HTMLElement;
  // 当前这局的生涯状态；null = 还在开始画面
  let s: GameState | null = E.load();
  const ui: Ui = {
    view: savedView(),
    pool: 'home',
    last: [],
    notice: '',
    pick: { region: 'LPL', pos: 'mid', trait: TRAITS.find((t) => t.start)!.id },
    name: '重生者',
    team: '重生战队',
    open: {},
    sel: null,
  };

  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!);
  const posName = (p: Position) => POSITIONS.find((x) => x.id === p)!.name;
  const num = (v: number) => String(Math.round(v * 10) / 10);

  const RARITY_CLS = [
    'border-zinc-300 text-zinc-600 dark:border-zinc-600 dark:text-zinc-400',
    'border-emerald-400/60 text-emerald-700 dark:text-emerald-400',
    'border-sky-400/70 text-sky-700 dark:text-sky-400',
    'border-violet-500 text-violet-700 dark:text-violet-400',
    'border-amber-400 text-amber-600 dark:text-amber-400',
  ];
  /** 词条品质的颜色：借用稀有度的配色（普通 / 稀有 / 史诗 / 传说） */
  const QUALITY_CLS = [RARITY_CLS[0], RARITY_CLS[1], RARITY_CLS[3], RARITY_CLS[4]];
  const LOG_CLS: Record<E.LogEntry['kind'], string> = {
    info: 'text-ink-muted',
    good: 'text-emerald-600 dark:text-emerald-400',
    bad: 'text-red-600 dark:text-red-400',
    match: 'text-ink',
    title: 'font-semibold text-violet-600 dark:text-violet-400',
    gacha: 'text-amber-700 dark:text-amber-400',
  };

  const bar = (v: number, max: number, cls: string) =>
    `<div class="h-1.5 w-full overflow-hidden rounded-full bg-chip"><div class="h-full rounded-full ${cls}" style="width:${Math.max(0, Math.min(100, (v / max) * 100))}%"></div></div>`;

  /** 五维的迷你条：越长颜色越深 */
  const attrBars = (p: { attrs?: Record<Attr, number> }) =>
    `<span class="flex items-center gap-0.5" title="${p.attrs ? esc(ATTRS.map((a) => `${a.name} ${p.attrs![a.id]}`).join(' · ')) : '青训选手，属性未知'}">${ATTRS.map(
      (a) => `<i class="h-1.5 w-2.5 rounded-full bg-violet-500" style="${p.attrs ? `opacity:${0.15 + (p.attrs![a.id] / 100) * 0.85}` : 'opacity:0.12'}"></i>`
    ).join('')}</span>`;

  type Row = { id: string; pos: Position; overall: number; attrs?: Record<Attr, number>; locked?: boolean; me?: boolean; note?: string; champ?: string; delta?: number | null; fresh?: boolean; wrap?: boolean };

  /** 和上赛季比：涨了几个、跌了几个；上赛季的名单里没有这个人就标“新” */
  const deltaChip = (p: Row) =>
    p.delta != null
      ? `<span class="w-7 shrink-0 text-right text-xs font-semibold tabular-nums ${p.delta > 0 ? 'text-emerald-600 dark:text-emerald-400' : p.delta < 0 ? 'text-red-600 dark:text-red-400' : 'text-ink-faint'}" title="和上赛季比的变化">${p.delta > 0 ? `▲${p.delta}` : p.delta < 0 ? `▼${-p.delta}` : '＝'}</span>`
      : p.fresh
        ? '<span class="w-7 shrink-0 text-right text-xs text-sky-700 dark:text-sky-400" title="上赛季的名单里没有他">新</span>'
        : '';

  const playerRow = (p: Row) => `
    <div class="flex items-center justify-between gap-2 py-1 text-sm ${p.me ? 'font-semibold text-ink' : 'text-ink-muted'}">
      <span class="flex min-w-0 items-center gap-1.5">
        <span class="w-8 shrink-0 text-xs text-ink-faint">${posName(p.pos)}</span>
        ${p.champ ? `<span class="shrink-0 whitespace-nowrap rounded bg-violet-500/10 px-1.5 py-0.5 text-xs font-semibold text-violet-700 dark:text-violet-400">${esc(p.champ)}</span>` : ''}
        <span class="${p.wrap ? 'min-w-0 whitespace-normal break-words' : 'truncate'}">${esc(p.id)}${p.locked ? ' <span title="非卖品：抽不到，也不能通过加入战队挤掉">🔒</span>' : ''}${p.note ? ` <span class="text-xs text-ink-faint">${esc(p.note)}</span>` : ''}</span>
      </span>
      <span class="flex shrink-0 items-center gap-2">${deltaChip(p)}${attrBars(p)}<b class="w-7 text-right tabular-nums ${p.me ? 'text-ink' : 'text-ink'}">${num(p.overall)}</b></span>
    </div>`;

  /** 一支队伍的五名首发；自己的位置显示成自己 */
  function rosterOf(st: GameState, teamId: string): Row[] {
    return POS_ORDER.map((pos) => {
      if (pos === st.pos && teamId === st.team.id) {
        return { id: `${st.name}（你）`, pos, overall: E.overall(st), attrs: st.attrs, me: true };
      }
      if (teamId === 'own') {
        const id = st.team.members[pos];
        const pro = id ? E.findPro(st, id) : undefined;
        return pro ? { ...pro } : { id: '青训选手', pos, overall: st.team.trainees[pos] };
      }
      const pro = E.cur(st).byId[teamId]?.roster[pos];
      return pro ? { ...pro } : { id: '—', pos, overall: E.cur(st).byId[teamId]?.rating ?? 50 };
    });
  }

  const teamHead = (st: GameState, id: string, tag = '') =>
    `<div class="flex items-baseline justify-between gap-2"><span class="font-semibold">${esc(E.teamLabel(st, id))}${tag ? ` <span class="rounded bg-chip px-1.5 py-0.5 text-[11px] font-normal text-ink-muted">${tag}</span>` : ''}</span><span class="text-sm text-ink-faint">实力 <b class="text-ink">${num(E.teamRating(st, id))}</b></span></div>`;

  const sideName = (bp: E.Bp, who: 'self' | 'opp') => (bp.blue === who ? '蓝色方' : '红色方');

  const card = (title: string, body: string, extra = '') =>
    `<section class="rounded-xl border border-edge bg-card p-4 ${extra}"><h3 class="mb-2 text-sm font-bold uppercase tracking-wide text-ink-faint">${title}</h3>${body}</section>`;

  // ---------- 各个画面 ----------
  function createScreen(): string {
    const save = E.load();
    const regions = E.availableRegions();
    return `
      <div class="mx-auto max-w-2xl space-y-4">
        <div class="rounded-xl border border-edge bg-card p-6">
          <h2 class="text-xl font-extrabold">开始新的生涯</h2>
          <p class="mt-1 text-sm text-ink-muted">2013 年，你带着上一世的记忆重生。选一个赛区、一个位置和一条开局词条，从 S3 打到 S5。</p>
          <label class="mt-4 block text-sm font-semibold">你的游戏 ID
            <input id="lol-name" maxlength="12" value="${esc(ui.name)}" class="mt-1 w-full rounded-lg border border-edge bg-page px-3 py-2 text-ink outline-none focus:border-violet-500" />
          </label>
          <p class="mt-4 text-sm font-semibold">赛区</p>
          <div class="mt-1 grid grid-cols-2 gap-2 sm:grid-cols-4">
            ${REGIONS.map((r) =>
              regions.includes(r.id)
                ? `<button type="button" data-pick="region" data-v="${r.id}" class="pick rounded-lg border px-3 py-2 text-left transition ${ui.pick.region === r.id ? 'border-violet-500 bg-violet-500/10' : 'border-edge hover:border-violet-500/50'}"><b>${r.name}</b><span class="block text-xs text-ink-faint">${r.desc}</span></button>`
                : `<div title="这个赛区当年的联赛名单没有录入，暂时不能选" class="cursor-not-allowed rounded-lg border border-dashed border-edge px-3 py-2 opacity-60"><b>${r.name}</b><span class="block text-xs text-ink-faint">暂不可选</span></div>`
            ).join('')}
          </div>
          <p class="mt-4 text-sm font-semibold">位置</p>
          <div class="mt-1 grid grid-cols-5 gap-2">
            ${POSITIONS.map((p) => `<button type="button" data-pick="pos" data-v="${p.id}" title="${p.weights ? Object.entries(p.weights).sort((a, b) => Number(b[1]) - Number(a[1])).slice(0, 2).map(([k]) => ATTRS.find((a) => a.id === k)!.name).join('、') + '最重要' : ''}" class="pick rounded-lg border px-2 py-2 text-sm transition ${ui.pick.pos === p.id ? 'border-violet-500 bg-violet-500/10 font-semibold text-ink' : 'border-edge text-ink-muted hover:border-violet-500/50'}">${p.name}</button>`).join('')}
          </div>
          <p class="mt-4 text-sm font-semibold">开局词条（选一个）<span class="ml-1.5 text-xs font-normal text-ink-faint">之后每加 ${E.PICK_EVERY} 点属性，还能再选一个</span></p>
          <div class="mt-1 grid gap-2">
            ${TRAITS.filter((t) => t.start).map(
              (t) => `<button type="button" data-pick="trait" data-v="${t.id}" class="pick rounded-lg border px-3 py-2 text-left transition ${ui.pick.trait === t.id ? 'border-violet-500 bg-violet-500/10' : 'border-edge hover:border-violet-500/50'}"><b class="text-ink">${t.name}</b><span class="block text-xs text-ink-muted">${t.desc}</span></button>`
            ).join('')}
          </div>
          <label class="mt-4 block text-sm font-semibold">你的战队叫什么
            <input id="lol-team" maxlength="12" value="${esc(ui.team)}" class="mt-1 w-full rounded-lg border border-edge bg-page px-3 py-2 text-ink outline-none focus:border-violet-500" />
          </label>
          <button type="button" data-act="new" class="mt-5 w-full rounded-xl bg-violet-600 px-5 py-3 font-semibold text-white transition hover:bg-violet-500">开始生涯</button>
        </div>
        ${save ? `<section class="rounded-xl border border-edge bg-card p-5"><h3 class="font-bold">继续上次的生涯</h3><p class="mt-1 text-sm text-ink-muted">${esc(save.name)} · ${E.cur(save).id} · ${esc(save.team.name)}</p><button type="button" data-act="resume" class="mt-3 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">继续</button></section>` : ''}
      </div>`;
  }

  /** 新赛季和上赛季比，本赛区的队伍有哪些增减；第一个赛季不显示 */
  function rosterSummary(st: GameState): string {
    const news = E.rosterNews(st);
    if (!news.ok) return '';
    const nameOf = (id: string) => E.cur(st).byId[id]?.zh || E.cur(st).byId[id]?.name || E.seasonBefore(st)?.byId[id]?.zh || E.seasonBefore(st)?.byId[id]?.name || id;
    const region = REGIONS.find((r) => r.id === st.region)!.name;
    const text = news.joined.length || news.left.length ? `加入 ${news.joined.map(nameOf).join('、') || '无'}，离开 ${news.left.map(nameOf).join('、') || '无'}` : '队伍没有增减';
    return `<p class="mt-2 text-sm leading-relaxed text-ink-muted">和上赛季比，${region} ${text}。每支队伍的名单和选手分数，可以在“战队”里点开看。</p>`;
  }

  function todayCard(st: GameState): string {
    if (st.modal?.kind === 'seasonStart') {
      const last = st.history[st.history.length - 1];
      return card(
        `${E.cur(st).id} 赛季开始`,
        `<p class="text-ink-muted">${E.cur(st).year} 年，你 ${st.age} 岁，效力于 <b class="text-ink">${esc(st.team.name)}</b>。</p>
        ${last ? `<table class="mt-3 w-full text-sm"><tbody>
          <tr class="border-t border-edge"><td class="py-1 text-ink-faint">上赛季（${last.id}）</td><td class="py-1 text-right">春季赛 ${esc(last.spring)} · 夏季赛 ${esc(last.summer)} · 世界赛 ${esc(last.worlds)}</td></tr>
          <tr class="border-t border-edge"><td class="py-1 text-ink-faint">获得荣誉</td><td class="py-1 text-right">${last.honors.length ? esc(last.honors.join('、')) : '无'}</td></tr>
        </tbody></table>` : ''}
        ${rosterSummary(st)}
        <p class="mt-3 text-sm text-ink-muted">现在是转会期：可以申请加入其他战队，或者留在自己的战队抽卡换人。</p>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" data-act="seasonTeams" class="rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">看看各战队的名单</button>
          <button type="button" data-act="seasonGo" class="rounded-xl border border-edge px-5 py-2.5 font-semibold text-ink transition hover:border-violet-500/50">开始训练</button>
        </div>`
      );
    }
    if (st.result) return resultCard(st, st.result);
    if (st.pending) return matchCard(st, st.pending);
    if (st.injury > 0) {
      return card(
        '带伤休战',
        `<p class="text-ink-muted">你正在养伤，还要休战 <b class="text-ink">${st.injury}</b> 天。伤好之前不能训练；比赛日照常上场，但实力会打折扣。</p>
        <button type="button" data-act="restInjury" class="mt-4 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">静养一天</button>`
      );
    }
    const window = E.isWindow(st);
    return card(
      `${E.today(st)} · ${E.phaseName(st)}${window ? '（转会期）' : ''}`,
      `<div class="grid gap-2 sm:grid-cols-2">
        ${E.ACTIONS.map((a) => {
          const c = E.canDo(st, a.id);
          const cost = E.costOf(st, a.id);
          return `<div class="rounded-lg border border-edge p-3 ${c.ok ? '' : 'opacity-50'}">
            <div class="flex items-baseline justify-between"><b>${a.name}</b><span class="text-xs text-ink-faint">体力 −${cost}</span></div>
            <p class="mt-0.5 text-xs text-ink-muted">${a.id === 'rank' ? `排位上分，赚一点资金` : a.desc}</p>
            <div class="mt-2 flex flex-wrap items-center gap-1.5">
              <button type="button" data-act="act" data-v="${a.id}" data-n="1" ${c.ok ? '' : 'disabled'} class="rounded-lg bg-violet-600 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-violet-500 disabled:cursor-not-allowed disabled:bg-zinc-400 dark:disabled:bg-zinc-600">做一天</button>
              ${c.ok ? `<button type="button" data-act="act" data-v="${a.id}" data-n="5" class="rounded-lg border border-edge px-3 py-1.5 text-xs text-ink-muted transition hover:border-violet-500/50 hover:text-ink">连续 5 天</button>` : `<span class="text-xs text-red-600 dark:text-red-400">${esc(c.why)}</span>`}
            </div>
          </div>`;
        }).join('')}
      </div>`
    );
  }

  /** 赛前 BP 板：每名首发前面标出他这一局用的英雄，队伍名下面是这一边禁用的三个 */
  function matchCard(st: GameState, m: E.Pending): string {
    // 引擎在比赛日一开始就把 BP 做好了，这里拿到的就是开打后真正用的那一份
    const bp = E.preMatch(st) ?? undefined;
    const col = (id: string, who: 'self' | 'opp') => {
      const side = bp?.[who];
      return `<div>${teamHead(st, id, bp ? sideName(bp, who) : '')}${
        side ? `<p class="mt-1 text-xs text-ink-faint">禁用${side.bans.map((c) => ` <span class="inline-block whitespace-nowrap rounded bg-chip px-1.5 py-0.5 text-ink-muted line-through decoration-red-500/70">${esc(c)}</span>`).join('')}</p>` : ''
      }
        <div class="mt-1">${rosterOf(st, id).map((p) => playerRow({ ...p, champ: side?.picks[POS_ORDER.indexOf(p.pos)] })).join('')}</div></div>`;
    };
    return card(
      `比赛日 · ${esc(m.label)}`,
      `<p class="mb-2 text-sm text-ink-muted"><b class="text-ink">第 1 局 BP</b>　双方各禁用 3 个英雄，五个位置各选 1 个；英雄名后面是这一局用它的选手。</p>
      <div class="grid gap-4 sm:grid-cols-2">${col(st.team.id, 'self')}${col(m.opp, 'opp')}</div>
      <p class="mt-3 text-sm text-ink-muted">赛制：${m.bo === 1 ? '单场决胜' : `BO${m.bo}`}${m.elim ? '，输了就出局' : ''}。${m.bo === 1 ? '' : '后面每一局的 BP 会随那一局的结果一起列出。'}</p>
      <button type="button" data-act="play" class="mt-4 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">开始比赛</button>`
    );
  }

  /** 赛后每一局的 BP：表头是两边各自的颜色方，下面两行是禁用 / 选出 */
  function bpBlock(st: GameState, bp: E.Bp | undefined): string {
    if (!bp) return '';
    const mine = POS_ORDER.indexOf(st.pos);
    // 英雄名整个不拆开，放不下时在名字和名字之间换行
    const names = (list: string[], o: { banned?: boolean; me?: boolean } = {}) =>
      `<span class="flex flex-wrap gap-x-2 gap-y-0.5">${list
        .map((c, i) => `<span class="whitespace-nowrap ${o.banned ? 'text-ink-faint line-through decoration-red-500/60' : o.me && i === mine ? 'font-semibold text-violet-600 dark:text-violet-400' : 'text-ink-muted'}">${esc(c)}</span>`)
        .join('')}</span>`;
    return `<div class="mt-1.5 grid grid-cols-[2.5em_1fr_1fr] gap-x-3 gap-y-1 text-xs">
          <span></span><span class="text-ink-faint">我方 · ${sideName(bp, 'self')}</span><span class="text-ink-faint">对方 · ${sideName(bp, 'opp')}</span>
          <span class="text-ink-faint">禁用</span>${names(bp.self.bans, { banned: true })}${names(bp.opp.bans, { banned: true })}
          <span class="text-ink-faint">选出</span>${names(bp.self.picks, { me: true })}${names(bp.opp.picks)}
        </div>`;
  }

  function resultCard(st: GameState, r: E.SeriesResult): string {
    return card(
      `${esc(r.label)}：${r.won ? '赢了' : '输了'} ${r.win}-${r.lose}`,
      `<p class="text-sm text-ink-muted">对手 ${esc(E.teamLabel(st, r.opp))}</p>
      <ol class="mt-3 space-y-2">${r.games.map(
        (g, i) => `<li class="rounded-lg border border-edge p-3 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-1">
            <span class="font-semibold ${g.win ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}">第 ${i + 1} 局 ${g.win ? '胜' : '负'}</span>
            <span class="text-ink">${esc(g.champ)}　<b class="tabular-nums">${g.k}/${g.d}/${g.a}</b>　<span class="text-ink-faint">${g.dur} 分钟</span></span>
            <span class="tabular-nums">评分 <b class="${g.score >= 8 ? 'text-emerald-600 dark:text-emerald-400' : g.score < 6 ? 'text-red-600 dark:text-red-400' : 'text-ink'}">${num(g.score)}</b>${g.mvp ? ' <span class="rounded bg-amber-400 px-1 text-xs font-bold text-zinc-900">MVP</span>' : ''}</span>
          </div>
          ${bpBlock(st, g.bp)}
          <p class="mt-1 text-ink-muted">${esc(g.note)}</p>
        </li>`
      ).join('')}</ol>
      <p class="mt-3 text-sm text-ink-muted">${esc(r.after)}</p>
      <button type="button" data-act="continue" class="mt-4 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">继续</button>`
    );
  }

  function leagueCard(st: GameState): string | null {
    const stage = st.pending?.split ?? (st.result?.split ?? null);
    const step = E.stepOf(st);
    const which: E.SplitId | null = stage ?? (step?.phase === 'springPo' ? 'spring' : step?.phase === 'summerPo' ? 'summer' : step?.phase === 'spring' ? 'spring' : step?.phase === 'summer' ? 'summer' : null);
    const sp = which ? st.split[which] : null;
    if (!which || !sp) return null;
    const order = E.tableOrder(st, sp);
    const po = sp.playoffs;
    return card(
      `${E.splitName(which)} · 积分榜`,
      `<div class="mb-2 flex justify-end"><button type="button" data-act="panel" data-v="teams" class="${BTN}">各战队的选手和分数 ›</button></div><table class="w-full text-sm"><tbody>${order.map((id, i) => {
        const t = sp.table[id];
        return `<tr class="${id === sp.mine ? 'font-semibold text-ink' : 'text-ink-muted'}"><td class="w-6 py-0.5 text-ink-faint">${i + 1}</td><td class="py-0.5">${esc(E.teamLabel(st, id))}${po?.champion === id ? ' 👑' : ''}</td><td class="py-0.5 text-right tabular-nums">${t.w} 胜 ${t.l} 负</td></tr>`;
      }).join('')}</tbody></table>
      ${po ? `<p class="mt-2 text-sm text-ink-muted">季后赛：${esc(E.teamLabel(st, po.champion!))} 夺冠，${esc(E.teamLabel(st, po.runnerUp!))} 亚军。</p>` : `<p class="mt-2 text-sm text-ink-faint">常规赛还剩 ${Math.max(0, sp.schedule.length - sp.played)} 场。前四名进季后赛。</p>`}`
    );
  }

  function worldsCard(st: GameState): string | null {
    const W = st.worlds;
    if (!W) return null;
    const name = (id: string | null | undefined) => (id ? esc(E.teamLabel(st, id)) : '待定');
    const groups = W.groups.map((g, i) => {
      const rows = W.order ? W.order[i] : g;
      return `<div class="min-w-[46%] flex-1"><p class="text-xs font-semibold text-ink-faint">${'ABCD'[i]} 组</p>${rows.map((id) => {
        const t = W.tables[i][id];
        return `<p class="flex justify-between text-sm ${id === st.team.id ? 'font-semibold text-ink' : 'text-ink-muted'}"><span>${name(id)}</span><span class="tabular-nums">${t.w}-${t.l}</span></p>`;
      }).join('')}</div>`;
    }).join('');
    const ko = W.bracket
      ? `<p class="mt-3 text-xs font-semibold text-ink-faint">淘汰赛</p>
        <p class="text-sm text-ink-muted">八强：${W.bracket.map(name).join('、')}</p>
        ${W.qfWinners ? `<p class="text-sm text-ink-muted">四强：${W.qfWinners.map(name).join('、')}</p>` : ''}
        ${W.sfWinners ? `<p class="text-sm text-ink-muted">决赛：${name(W.sfWinners[0])} 对 ${name(W.sfWinners[1])}</p>` : ''}
        ${W.champion ? `<p class="text-sm font-semibold text-ink">冠军：${name(W.champion)}</p>` : ''}`
      : W.seeds.length
        ? `<p class="mt-3 text-sm text-ink-muted">直接进八强：${W.seeds.map(name).join('、')}</p>`
        : '';
    return card(`${E.cur(st).id} 全球总决赛`, `<div class="flex flex-wrap gap-4">${groups}</div>${ko}<div class="mt-3"><button type="button" data-act="panel" data-v="teams" class="${BTN}">各战队的选手和分数 ›</button></div>`);
  }

  const BTN = 'rounded-lg border border-edge px-3 py-1.5 text-xs font-semibold text-ink transition hover:border-violet-500/50 disabled:cursor-not-allowed disabled:opacity-50';

  function attrsCard(st: GameState): string {
    const w = POSITIONS.find((p) => p.id === st.pos)!.weights as Record<Attr, number>;
    return card(
      `属性 · 可用训练点 <span class="text-violet-600 dark:text-violet-400">${st.tp}</span>`,
      `<dl class="space-y-2.5">${ATTRS.map((a) => {
        const v = st.attrs[a.id];
        const cost = E.pointCostFor(st, a.id);
        const can = v < 99 && st.tp >= cost;
        return `<div class="flex items-center gap-3">
          <dt class="w-14 shrink-0 text-sm font-semibold" title="${esc(a.desc)}">${a.name}<span class="ml-1 text-[11px] font-normal text-ink-faint">${Math.round(w[a.id] * 100)}%</span></dt>
          <dd class="min-w-0 flex-1">${bar(v, 99, 'bg-violet-500')}<p class="mt-0.5 text-[11px] text-ink-faint">${esc(a.desc)}</p></dd>
          <button type="button" data-act="point" data-v="${a.id}" ${can ? '' : 'disabled'} title="${v >= 99 ? '已经加满' : `加 1 点要花 ${cost} 训练点`}" class="w-[4.5rem] shrink-0 rounded-lg border px-2 py-1 text-xs font-semibold transition ${can ? 'border-violet-500/60 text-violet-600 hover:bg-violet-500/10 dark:text-violet-400' : 'cursor-not-allowed border-edge text-ink-faint opacity-60'}">+1<span class="font-normal">（${cost}）</span></button>
        </div>`;
      }).join('')}</dl>
      <p class="mt-3 text-xs text-ink-faint">综合实力 <b class="text-ink">${num(E.overall(st))}</b>（${E.gradeOf(E.overall(st))}）：按${posName(st.pos)}对五项的权重加权。属性越高，每一点越贵。</p>`
    );
  }

  /** 词条卡：有机会选的时候放一个入口；下面按拿到的顺序倒着列，新拿的在最上面 */
  function traitsCard(st: GameState): string {
    const owed = st.traitPicks;
    const done = st.pointsAdded % E.PICK_EVERY;
    const chip = (t: (typeof TRAITS)[number]) =>
      t.pick && t.quality != null
        ? `<span class="rounded border px-1.5 py-0.5 text-[11px] font-semibold ${QUALITY_CLS[t.quality]}">${QUALITY[t.quality].name}</span>`
        : `<span class="rounded border px-1.5 py-0.5 text-[11px] font-semibold ${t.start ? RARITY_CLS[2] : t.bad ? 'border-red-300 text-red-600 dark:border-red-500/50 dark:text-red-400' : 'border-edge text-ink-faint'}">${t.start ? '开局' : t.bad ? '隐患' : '达成'}</span>`;
    return card(
      `词条 · ${st.traits.length}`,
      `${
        owed > 0
          ? `<button type="button" data-act="pickOpen" class="w-full rounded-xl bg-violet-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-violet-500">选择新词条（${owed}）</button>`
          : `<p class="text-xs text-ink-faint">再加 ${E.PICK_EVERY - done} 点属性，可以选一个新词条。</p>${bar(done, E.PICK_EVERY, 'bg-violet-500')}`
      }
      <ul class="mt-3 space-y-2">${[...st.traits].reverse().map((id) => {
        const t = TRAITS.find((x) => x.id === id);
        return t ? `<li class="text-sm"><span class="mb-0.5 flex items-center gap-1.5">${chip(t)}<b class="${t.bad ? 'text-red-600 dark:text-red-400' : 'text-ink'}">${t.name}</b></span><span class="block text-xs leading-relaxed text-ink-muted">${t.desc}</span></li>` : '';
      }).join('')}</ul>
      <p class="mt-3 text-[11px] leading-relaxed text-ink-faint">同类加成叠起来，不会超过其中最强的那一个；胜率类的加起来最多 +${Math.round(E.PICK_WIN_CAP * 100)}%。</p>`
    );
  }

  /** 选词条：三个选项，点一个就选走 */
  function pickPanel(st: GameState): string {
    const offer = E.traitOptions(st);
    return card(
      `选择词条 · 还可以选 ${st.traitPicks} 次`,
      `<p class="text-sm text-ink-muted">三选一。品质越高越难遇到，效果也越强；连续 ${E.EPIC_PITY} 次没出史诗以上，下一次必出。</p>
      <div class="mt-3 grid gap-2 sm:grid-cols-3">${offer.map(
        (t) => `<button type="button" data-act="pick" data-v="${t.id}" class="rounded-xl border bg-page p-3 text-left transition hover:-translate-y-0.5 hover:shadow-sm ${QUALITY_CLS[t.quality ?? 0]}"><span class="text-[11px] font-semibold">${QUALITY[t.quality ?? 0].name}</span><b class="mt-0.5 block text-base text-ink">${t.name}</b><span class="mt-1 block text-sm leading-relaxed text-ink-muted">${t.desc}</span></button>`
      ).join('')}</div>
      <button type="button" data-act="pickLater" class="mt-4 text-sm text-violet-600 hover:underline dark:text-violet-400">稍后再选</button>`
    );
  }

  function teamCard(st: GameState): string {
    const win = E.isWindow(st);
    const own = st.team.kind === 'own';
    const lead = E.traitFx(st).all.lead;
    return card(
      `我的战队${st.team.coord > 0 ? ` · 磨合 +${num(st.team.coord)}` : ''}${lead > 0 ? ` · 指挥 +${num(lead)}` : ''}`,
      `${teamHead(st, st.team.id)}<div class="mt-1">${rosterOf(st, st.team.id).map(playerRow).join('')}</div>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-act="panel" data-v="teams" class="${BTN}">${own ? '查看战队 / 申请加入其他战队' : '查看战队 / 申请转会'}</button>
        ${own ? `<button type="button" data-act="panel" data-v="gacha" ${win ? '' : 'disabled'} class="${BTN}">抽卡换人</button>` : ''}
      </div>
      ${win ? '' : '<p class="mt-2 text-xs text-ink-faint">转会期才能换队、抽卡、调整阵容。</p>'}`
    );
  }

  function honorsCard(st: GameState): string {
    return card(
      `荣誉 · ${st.honors.length}`,
      st.honors.length
        ? `<ul class="space-y-1 text-sm text-ink-muted">${[...st.honors].reverse().map((h) => `<li><span class="text-ink-faint">${h.season}</span>　${esc(h.name)}</li>`).join('')}</ul>`
        : '<p class="text-sm text-ink-faint">还没有荣誉。</p>'
    );
  }

  /** 战队面板：本赛区的联赛队伍，加上其他赛区的队伍。点一支展开，看选手、分数和相比上赛季的变化 */
  function teamsPanel(st: GameState): string {
    const win = E.isWindow(st);
    const mine = st.team.kind === 'real' ? st.team.id : '';
    const own = st.team.kind === 'own';
    const sn = E.cur(st);
    const prev = E.seasonBefore(st);
    const league = E.leagueIds(st);
    const news = E.rosterNews(st);
    const regionName = (code: string) => REGIONS.find((r) => r.id === code)?.name ?? code;
    const nameOf = (id: string) => sn.byId[id]?.zh || sn.byId[id]?.name || prev?.byId[id]?.zh || prev?.byId[id]?.name || id;
    const stage = st.pending?.split ?? st.result?.split ?? null;

    /** 选手的上赛季：分数差了多少；换了队的话注明当时在哪 */
    const withHistory = (p: ProPlayer): Row => {
      const before = prev?.byUid[p.uid];
      if (!before) return { ...p, fresh: !!prev };
      const from = prev?.byId[before.team];
      return { ...p, delta: p.overall - before.overall, note: before.team !== p.team && from ? `上赛季在 ${from.zh || from.name}` : '' };
    };

    /** 一支队伍：收着的时候只有一行队名，点开才列出选手 */
    const teamBlock = (id: string, inLeague: boolean) => {
      const open = !!ui.open[id];
      const here = id === mine;
      const team = sn.byId[id];
      const move = inLeague ? news.moves.find((m) => m.team === id) : undefined;
      // “换了几个首发”：进来的和离开的取多的那边（4 进 4 出就是换了 4 人）
      const changed = move ? Math.max(move.joined.length, move.left.length) : 0;
      const record = stage ? st.split[stage]?.table[id] : undefined;
      // 手机上地方小，只显示中文简称；桌面端显示“英文名（中文简称）”
      const label = E.teamLabel(st, id);
      const short = id === 'own' || !team?.zh || team.zh === team.name ? label : team.zh;
      const head = `<button type="button" data-act="toggle" data-v="${id}" aria-expanded="${open}" class="flex w-full items-center gap-2 px-2 py-2 text-left transition hover:bg-chip">
          <span class="shrink-0 text-xs text-ink-faint">${open ? '▾' : '▸'}</span>
          <span class="min-w-0 flex-1 leading-relaxed"><b class="font-semibold text-ink"><span class="sm:hidden">${esc(short)}</span><span class="hidden sm:inline">${esc(label)}</span></b>${here ? ' <span class="text-xs text-violet-600 dark:text-violet-400">你在这里</span>' : ''}${inLeague && news.joined.includes(id) ? ' <span class="rounded bg-sky-500/10 px-1 text-[11px] text-sky-700 dark:text-sky-400">新队伍</span>' : ''}${changed >= 3 ? ` <span class="rounded bg-chip px-1 text-[11px] text-ink-muted">换了 ${changed} 人</span>` : ''}</span>
          <span class="shrink-0 text-xs text-ink-faint">${record ? `${record.w} 胜 ${record.l} 负 · ` : ''}实力 <b class="text-ink">${num(E.teamRating(st, id))}</b></span>
        </button>`;
      if (!open) return head;
      const rows: Row[] = id === 'own' ? rosterOf(st, 'own') : POS_ORDER.map((pos) => team?.roster[pos] ?? { id: '—', pos, overall: team?.rating ?? 50 });
      const gone = move?.left.map((l) => `${esc(l.p.id)}${l.to ? `（去了 ${esc(l.to)}）` : '（离开联赛）'}`) ?? [];
      const it = E.interest(st, id);
      return `${head}<div class="px-2 pb-2">
          <div>${id === 'own' ? rows.map(playerRow).join('') : rows.map((r) => playerRow({ ...withHistory(r as ProPlayer), wrap: true })).join('')}</div>
          ${gone.length ? `<p class="mt-1 text-xs leading-relaxed text-ink-faint">上赛季还在、现在不在队里：${gone.join('、')}</p>` : ''}
          ${inLeague && id !== 'own' ? `<div class="mt-2 flex items-center justify-between gap-2"><span class="text-xs ${it.ok ? 'text-emerald-600 dark:text-emerald-400' : 'text-ink-faint'}">${here ? '你现在的战队' : it.ok ? '对你有意向' : esc(it.why)}</span>${here ? '' : `<button type="button" data-act="join" data-v="${id}" ${it.ok ? '' : 'disabled'} class="${BTN}">加入</button>`}</div>` : ''}
        </div>`;
    };
    const list = (ids: string[], inLeague: boolean) => `<div class="divide-y divide-edge rounded-lg border border-edge">${ids.map((id) => teamBlock(id, inLeague)).join('')}</div>`;
    const others = sn.teams.filter((t) => !sn.leagues[st.region].includes(t.id));
    const groups = [...new Set(others.map((t) => t.region))];
    const allOpen = league.every((id) => ui.open[id]);
    const summary = !prev
      ? '这是第一个赛季，还没有可以对比的上赛季。'
      : news.joined.length || news.left.length
        ? `和上赛季比：<b class="text-ink">${regionName(st.region)}</b> 加入 ${news.joined.map(nameOf).join('、')}，离开 ${news.left.map(nameOf).join('、')}。`
        : `和上赛季比，${regionName(st.region)} 的队伍没有增减。`;
    return card(
      `战队 · ${sn.id}（${sn.year} 年）`,
      `<p class="text-sm leading-relaxed text-ink-muted">${summary}</p>
      <div class="mt-3 flex items-center justify-between gap-2">
        <p class="text-xs font-semibold uppercase tracking-wide text-ink-faint">${regionName(st.region)} 联赛 · 点一支队伍看选手</p>
        <button type="button" data-act="expandAll" class="shrink-0 text-xs text-violet-600 hover:underline dark:text-violet-400">${allOpen ? '全部收起' : '全部展开'}</button>
      </div>
      <div class="mt-1">${list(league, true)}</div>
      <p class="mt-4 text-xs font-semibold uppercase tracking-wide text-ink-faint">其他赛区</p>
      ${groups.map((g) => `<p class="mt-2 text-xs text-ink-muted">${regionName(g)}</p><div class="mt-1">${list(others.filter((t) => t.region === g).map((t) => t.id), false)}</div>`).join('')}
      <p class="mt-3 text-xs leading-relaxed text-ink-faint">实力是 0–99 的评分；▲▼ 是和上赛季比的变化，换了队的会注明上赛季在哪。${win ? '现在是转会期，对你有意向的战队可以申请加入。' : '转会期才能申请加入其他战队。'}</p>
      <div class="mt-4 rounded-lg border border-dashed border-edge p-3">
        <p class="text-sm font-semibold text-ink">${own ? '给自己的战队改名' : '离开现在的战队，成立自己的战队'}</p>
        <p class="mt-1 text-xs text-ink-muted">${own ? '' : '成立后可以抽卡换人，世界赛名额要靠自己的战队打出来。'}</p>
        <div class="mt-2 flex gap-2">
          <input id="lol-own-name" maxlength="12" placeholder="战队名" value="${own ? esc(st.team.name) : ''}" class="min-w-0 flex-1 rounded-lg border border-edge bg-page px-3 py-1.5 text-sm text-ink outline-none focus:border-violet-500" />
          <button type="button" data-act="own" ${win ? '' : 'disabled'} class="${BTN}">${own ? '改名' : '成立战队'}</button>
        </div>
      </div>
      <button type="button" data-act="panel" data-v="main" class="mt-4 text-sm text-violet-600 hover:underline dark:text-violet-400">← 返回</button>`
    );
  }
  /**
   * 抽卡面板。抽到的选手都在“替补席”的卡牌墙里：一行多张，最新抽到的排在最前，之前抽到的不会被清掉。
   * 点一张卡才展开它的详情和“放进首发 / 放走”。
   */
  function gachaPanel(st: GameState): string {
    const win = E.isWindow(st);
    const pool = E.poolOf(st, ui.pool);
    const tiers = E.RARITY.map((r, i) => ({ ...r, n: pool.filter((p) => E.rarityOf(p.overall) === i).length })).reverse();
    const can = (n: number) => win && st.funds >= E.DRAW_COST * n;
    const DRAW_BTN = 'rounded-xl bg-amber-500 px-4 py-2 text-sm font-semibold text-zinc-900 transition hover:bg-amber-400 disabled:cursor-not-allowed disabled:opacity-50';
    const fresh = new Set(ui.last.map((p) => p.id));
    // 替补席是按抽到的先后存的，倒过来就是最新的在前面
    const cards = [...st.bench].reverse().filter((id) => E.findPro(st, id));
    // 注意别叫 card：外面那个 card() 是生成整块面板的
    const tile = (id: string) => {
      const p = E.findPro(st, id)!;
      const r = E.rarityOf(p.overall);
      const from = E.cur(st).byId[p.team];
      return `<button type="button" data-act="sel" data-v="${esc(id)}" aria-pressed="${ui.sel === id}" class="rounded-lg border bg-page p-2 text-center transition hover:-translate-y-0.5 ${RARITY_CLS[r]}${ui.sel === id ? ' ring-2 ring-violet-500' : ''}">
          <p class="text-[11px] font-semibold leading-4">${E.RARITY[r].name}${fresh.has(id) ? ' · 新抽到' : ''}</p>
          <p class="truncate text-sm font-semibold text-ink" title="${esc(id)}">${esc(id)}</p>
          <p class="text-[11px] leading-4 text-ink-muted">${posName(p.pos)} · <b class="text-ink tabular-nums">${p.overall}</b></p>
          <p class="truncate text-[11px] leading-4 text-ink-faint">${esc(from?.zh || from?.name || '')}</p>
        </button>`;
    };
    const sel = ui.sel && st.bench.includes(ui.sel) ? E.findPro(st, ui.sel) : undefined;
    const detail = !sel
      ? ''
      : `<div class="mt-2 rounded-lg border border-violet-500/50 p-3 text-sm">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <span class="min-w-0"><b class="text-ink">${esc(sel.id)}</b> <span class="text-ink-faint">【${E.RARITY[E.rarityOf(sel.overall)].name}】${posName(sel.pos)} · 来自 ${esc(E.teamLabel(st, sel.team))}</span></span>
            <span class="flex shrink-0 items-center gap-2">${attrBars(sel)}<b class="text-ink tabular-nums">${sel.overall}</b></span>
          </div>
          <div class="mt-2 flex flex-wrap gap-2">
            <button type="button" data-act="field" data-v="${esc(sel.id)}" ${win ? '' : 'disabled'} class="${BTN}">放进首发</button>
            <button type="button" data-act="release" data-v="${esc(sel.id)}" ${win ? '' : 'disabled'} class="${BTN}">放走</button>
          </div>
        </div>`;
    return card(
      `抽卡 · 资金 <span class="text-amber-600 dark:text-amber-400">${st.funds}</span> · 保底进度 ${st.pity}/10`,
      `<div class="flex flex-wrap items-center gap-2">
        ${(['home', 'away'] as E.Pool[]).map((p) => `<button type="button" data-act="pool" data-v="${p}" class="${BTN} ${ui.pool === p ? '!border-violet-500 bg-violet-500/10' : ''}">${p === 'home' ? '本赛区' : '外援'}</button>`).join('')}
        <span class="ml-auto text-xs text-ink-faint">非卖品抽不到 · 首发外援最多${E.importLimit(st) === 2 ? '两人' : `${E.importLimit(st)} 人`}</span>
      </div>
      <p class="mt-2 text-xs text-ink-muted">卡池里现有 ${pool.length} 名选手：${tiers.map((r) => `${r.name} ${r.n}`).join(' · ')}</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-act="draw" data-v="1" ${can(1) ? '' : 'disabled'} class="${DRAW_BTN}">抽 1 次（${E.DRAW_COST}）</button>
        <button type="button" data-act="draw" data-v="10" ${can(10) ? '' : 'disabled'} class="${DRAW_BTN}">抽 10 次（${E.DRAW_COST * 10}）</button>
      </div>
      ${ui.last.length ? `<p class="mt-2 text-xs leading-relaxed text-ink-muted">这一抽抽到：${ui.last.map((p) => `${esc(p.id)}（${E.RARITY[E.rarityOf(p.overall)].name}）`).join('、')}</p>` : ''}
      <p class="mt-4 text-sm font-semibold text-ink">替补席（${cards.length}）<span class="ml-1 text-xs font-normal text-ink-faint">最新抽到的排在前面，点一张卡看详情</span></p>
      ${
        cards.length
          ? `<div class="mt-2 grid grid-cols-3 gap-2 sm:grid-cols-4 lg:grid-cols-6">${cards.map(tile).join('')}</div>`
          : '<p class="mt-1 text-xs text-ink-faint">替补席是空的。抽到的选手会先放在这里，之前抽到的不会被清掉。</p>'
      }
      ${detail}
      <p class="mt-4 text-sm font-semibold text-ink">首发阵容</p>
      <div class="mt-1">${POS_ORDER.map((pos) => {
        const id = st.team.members[pos];
        return `<div class="flex items-center justify-between gap-2 py-1 text-sm text-ink-muted"><span class="w-8 shrink-0 text-xs text-ink-faint">${posName(pos)}</span><span class="min-w-0 flex-1 truncate">${pos === st.pos ? `<b class="text-ink">${esc(st.name)}（你）</b>` : id ? `${esc(id)} <button type="button" data-act="bench" data-v="${pos}" ${win ? '' : 'disabled'} class="text-xs text-violet-600 hover:underline disabled:text-ink-faint disabled:no-underline dark:text-violet-400">换下</button>` : '青训选手'}</span></div>`;
      }).join('')}</div>
      <p class="mt-3 text-xs text-ink-faint">每抽 ${E.DRAW_COST} 资金。连续 10 抽没出核心以上，下一抽必出。抽到的选手会离开原来的队伍。</p>
      <button type="button" data-act="panel" data-v="main" class="mt-3 text-sm text-violet-600 hover:underline dark:text-violet-400">← 返回</button>`
    );
  }
  const stat = (label: string, body: string, foot: string) =>
    `<div class="rounded-xl border border-edge bg-card p-3"><p class="text-xs text-ink-faint">${label}</p><div class="mt-1">${body}</div>${foot ? `<p class="mt-1 text-[11px] text-ink-faint">${foot}</p>` : ''}</div>`;

  const noticeBlock = () => (ui.notice ? `<p class="mb-3 rounded-lg border border-amber-400/60 bg-amber-400/10 px-3 py-2 text-sm text-ink">${esc(ui.notice)}</p>` : '');

  function mainScreen(st: GameState): string {
    const t = E.tierOf(st);
    return `
      <div class="mb-3 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <p class="text-lg font-extrabold">${E.cur(st).id} <span class="text-ink-faint">·</span> ${E.cur(st).year} 年</p>
        <p class="text-sm text-ink-muted">${esc(st.name)} · ${REGIONS.find((r) => r.id === st.region)!.name} · ${posName(st.pos)} · ${st.age} 岁</p>
      </div>
      ${noticeBlock()}
      <div class="grid grid-cols-2 gap-2 sm:grid-cols-5">
        ${stat(`段位 ${t.name}`, bar(st.rank - t.min, t.span, 'bg-sky-500'), `${st.rank} / ${t.max} 分`)}
        ${stat('综合实力', `<p class="text-2xl font-extrabold tabular-nums">${num(E.overall(st))}</p>`, `${E.gradeOf(E.overall(st))} 级`)}
        ${stat(`体力 ${Math.round(st.stamina)} / ${st.maxStamina}`, bar(st.stamina, st.maxStamina, st.stamina < 30 ? 'bg-red-500' : 'bg-emerald-500'), st.injury > 0 ? `带伤，休战 ${st.injury} 天` : '')}
        ${stat('训练点', `<p class="text-2xl font-extrabold tabular-nums">${st.tp}</p>`, '用来加点')}
        ${stat('资金', `<p class="text-2xl font-extrabold tabular-nums">${st.funds}</p>`, '用来抽卡')}
      </div>
      <div class="mt-3 grid gap-3 lg:grid-cols-5">
        <div class="space-y-3 lg:col-span-3">${todayCard(st)}${leagueCard(st) ?? ''}${worldsCard(st) ?? ''}</div>
        <div class="space-y-3 lg:col-span-2">${attrsCard(st)}${teamCard(st)}${traitsCard(st)}${honorsCard(st)}</div>
      </div>
      <section class="mt-3 rounded-xl border border-edge bg-card p-4">
        <h3 class="mb-2 text-sm font-bold uppercase tracking-wide text-ink-faint">生涯记录</h3>
        <ol class="space-y-1.5">${st.log.slice(0, 40).map((l) => `<li class="text-sm leading-relaxed"><span class="mr-2 text-xs text-ink-faint">${esc(l.date)}</span><span class="${LOG_CLS[l.kind]}">${esc(l.text)}</span></li>`).join('')}</ol>
      </section>
      <p class="mt-3 text-right"><button type="button" data-act="restart" class="text-xs text-ink-faint hover:text-red-600 hover:underline dark:hover:text-red-400">放弃这局，重新开始</button></p>`;
  }

  function endScreen(st: GameState): string {
    const c = E.careerSummary(st);
    return card(
      '生涯结束',
      `<p class="text-2xl font-extrabold">${esc(st.name)}，${c.years} 个赛季，${c.age} 岁</p>
      <p class="mt-2 text-ink-muted">最终实力 <b class="text-ink">${c.overall}</b>（${c.grade}）· 比赛 ${c.record} · 系列赛 ${c.seriesRecord} · MVP ${c.mvp} 次</p>
      <p class="mt-4 text-sm font-semibold text-ink">拿到的冠军（${c.titles.length}）</p>
      ${c.titles.length ? `<ul class="mt-1 space-y-1 text-sm text-ink-muted">${[...c.titles].reverse().map((t) => `<li>${esc(t)}</li>`).join('')}</ul>` : '<p class="mt-1 text-sm text-ink-faint">一个冠军都没拿到。再来一次？</p>'}
      <table class="mt-4 w-full text-sm">
        <thead><tr class="text-left text-xs text-ink-faint"><th class="py-1 font-normal">赛季</th><th class="py-1 font-normal">战队</th><th class="py-1 font-normal">春季赛</th><th class="py-1 font-normal">夏季赛</th><th class="py-1 font-normal">世界赛</th></tr></thead>
        <tbody>${st.history.map((h) => `<tr class="border-t border-edge"><td class="py-1">${h.id}</td><td class="py-1">${esc(h.team)}</td><td class="py-1">${esc(h.spring)}</td><td class="py-1">${esc(h.summer)}</td><td class="py-1">${esc(h.worlds)}</td></tr>`).join('')}</tbody>
      </table>
      <button type="button" data-act="restart" class="mt-5 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500">再来一次</button>`
    );
  }

  function render(): void {
    // 选词条的面板在没有可选词条时就回到主界面；再把当前所在的面板记下来，刷新页面后还回到这里
    if (s && ui.view === 'pick' && s.traitPicks <= 0) ui.view = 'main';
    try {
      sessionStorage.setItem(VIEW_KEY, ui.view);
    } catch {
      /* 存不了就算了 */
    }
    if (!s) root.innerHTML = createScreen();
    else if (s.screen === 'careerEnd') root.innerHTML = `<div class="mx-auto max-w-2xl">${endScreen(s)}</div>`;
    else if (ui.view !== 'main') root.innerHTML = `<div class="mx-auto max-w-3xl">${noticeBlock()}${ui.view === 'teams' ? teamsPanel(s) : ui.view === 'pick' ? pickPanel(s) : gachaPanel(s)}</div>`;
    else root.innerHTML = mainScreen(s);
  }

  // ---------- 事件 ----------
  root.addEventListener('input', (e: Event) => {
    const el = e.target as HTMLInputElement;
    if (el.id === 'lol-name') ui.name = el.value;
    if (el.id === 'lol-team') ui.team = el.value;
  });

  root.addEventListener('click', (e: Event) => {
    const target = e.target as HTMLElement;
    const option = target.closest<HTMLElement>('[data-pick]');
    if (option) {
      const key = option.dataset.pick as 'region' | 'pos' | 'trait';
      ui.pick[key] = option.dataset.v as never;
      render();
      return;
    }
    const el = target.closest<HTMLElement>('[data-act]');
    if (!el || el.hasAttribute('disabled')) return;
    const act = el.dataset.act!;
    const v = el.dataset.v ?? '';
    ui.notice = '';
    if (act === 'new') s = E.createGame({ name: ui.name, region: ui.pick.region, pos: ui.pick.pos, trait: ui.pick.trait, teamName: ui.team });
    else if (act === 'resume') s = E.load();
    else if (act === 'restart') {
      if (!window.confirm('确定要放弃现在的生涯、重新开始吗？')) return;
      E.clearSave();
      s = null;
      ui.view = 'main';
      ui.last = [];
      ui.open = {};
      ui.sel = null;
    } else if (s) {
      switch (act) {
        case 'act':
          E.act(s, v as E.Action, Number(el.dataset.n ?? 1));
          break;
        case 'restInjury':
          E.restInjury(s);
          break;
        case 'point':
          E.addPoint(s, v as Attr);
          // 加满了一次，直接进入选词条
          if (ui.view === 'main' && s.traitPicks > 0) ui.view = 'pick';
          break;
        case 'pickOpen':
          ui.view = 'pick';
          break;
        case 'pick':
          if (E.pickTrait(s, v)) {
            ui.last = [];
            if (s.traitPicks <= 0) ui.view = 'main';
          }
          break;
        case 'pickLater':
          ui.view = 'main';
          break;
        case 'play':
          E.playPending(s);
          break;
        case 'continue':
          E.continueAfterResult(s);
          break;
        case 'seasonGo':
          E.closeSeasonStart(s);
          break;
        case 'seasonTeams':
          E.closeSeasonStart(s);
          ui.view = 'teams';
          break;
        case 'panel':
          ui.view = v as Ui['view'];
          break;
        case 'toggle':
          ui.open[v] = !ui.open[v];
          break;
        case 'expandAll': {
          const ids = E.leagueIds(s);
          const open = !ids.every((id) => ui.open[id]);
          for (const id of ids) ui.open[id] = open;
          break;
        }
        case 'join':
          if (E.joinTeam(s, v)) ui.view = 'main';
          else ui.notice = E.interest(s, v).why;
          break;
        case 'own': {
          const name = (document.getElementById('lol-own-name') as HTMLInputElement | null)?.value ?? '';
          if (!E.makeOwnTeam(s, name)) ui.notice = E.isWindow(s) ? '请先给战队起个名字' : '只能在转会期成立战队';
          break;
        }
        case 'pool':
          ui.pool = v as E.Pool;
          break;
        case 'draw': {
          // 抽到的选手进替补席（卡牌墙），之前抽到的都还在；这里只记下“这一抽”抽到了谁
          ui.last = E.draw(s, ui.pool, Number(v));
          if (!ui.last.length) ui.notice = E.isWindow(s) ? (s.funds < E.DRAW_COST * Number(v) ? '资金不够' : '卡池里已经没有可抽的选手了') : '只能在转会期抽卡';
          else ui.sel = [...ui.last].sort((a, b) => b.overall - a.overall)[0].id;
          break;
        }
        case 'sel':
          ui.sel = ui.sel === v ? null : v;
          break;
        case 'field': {
          const p = E.findPro(s, v);
          const r = p ? E.setMember(s, p.pos, v) : { ok: false, why: '找不到这名选手' };
          if (!r.ok) ui.notice = r.why;
          else ui.sel = null;
          break;
        }
        case 'bench':
          E.setMember(s, v as Position, null);
          break;
        case 'release':
          E.release(s, v);
          ui.sel = null;
          break;
      }
    }
    if (s) E.save(s);
    render();
  });

  // 仅开发环境：方便在浏览器里调试
  if (import.meta.env.DEV) {
    const errors: string[] = [];
    window.addEventListener('error', (e) => errors.push(String(e.message)));
    (window as unknown as { __lol: unknown }).__lol = { get: () => s, set: (x: GameState) => { s = x; render(); }, refresh: () => render(), ui, E, errors };
  }

  render();
</script>
