---
import categories from '../data/categories.json';
import { t, localePath, type Locale } from '../i18n/ui';
import { catLabel } from '../i18n/categories';
import { toolSlug } from '../i18n/paths';

interface Tool {
  name: string;
  url: string;
  repo?: string;
  category: string;
  categories?: string[];
  capabilities?: string[];
  pricing: string;
  engines: string[];
  tested: boolean;
  oneLiner: string;
}

interface Props {
  tool: Tool;
  locale?: Locale;
}

const { tool, locale = 'en' } = Astro.props;
const slug = toolSlug(tool.name);
const catSlugs = tool.categories ?? [tool.category];

const priceStyles: Record<string, string> = {
  free: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400',
  freemium: 'border-sky-500/30 bg-sky-500/10 text-sky-700 dark:text-sky-400',
  paid: 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400',
};
---

<div
  data-tool
  data-search={`${tool.name} ${catSlugs.join(' ')} ${(tool.capabilities ?? []).join(' ')} ${tool.oneLiner}`.toLowerCase()}
  class="group relative flex flex-col gap-2 rounded-xl border border-edge bg-card p-4 transition hover:border-violet-500/50 hover:bg-card-hover"
>
  <!-- 行1：名字 + 元信息（徽章/直达/定价/引擎） -->
  <div class="flex flex-wrap items-start justify-between gap-x-2 gap-y-1">
    <h3 class="font-semibold leading-tight">
      <a href={localePath(locale, `/tool/${slug}`)} class="after:absolute after:inset-0 group-hover:text-violet-600 dark:group-hover:text-violet-300">{tool.name}</a>
    </h3>

    <div class="flex shrink-0 flex-wrap items-center gap-1.5 text-[11px]">
      <span class={`rounded-full border px-2 py-0.5 ${tool.tested ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' : 'border-chip-border bg-chip text-ink-muted'}`}>
        {tool.tested ? t(locale, 'card.tested') : t(locale, 'card.unverified')}
      </span>
      {tool.repo && (
        <a
          href={tool.repo}
          target="_blank"
          rel="noopener noreferrer"
          title={t(locale, 'card.github')}
          aria-label={`${tool.name} GitHub`}
          class="relative z-10 rounded-md p-1 text-ink-faint transition hover:text-ink"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
          </svg>
        </a>
      )}
      <a
        href={tool.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
        title={t(locale, 'card.website')}
        aria-label={`${tool.name} website`}
        class="relative z-10 rounded-md p-1 text-ink-faint transition hover:text-violet-600 dark:hover:text-violet-400"
      >
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
          <path d="M15 3h6v6" />
          <path d="M10 14 21 3" />
        </svg>
      </a>
      <span class={`rounded-full border px-2 py-0.5 capitalize ${priceStyles[tool.pricing] ?? priceStyles.freemium}`}>{tool.pricing}</span>
      <span class="text-ink-faint">{tool.engines.filter((e) => e !== 'any').join(' · ') || t(locale, 'card.any')}</span>
    </div>
  </div>

  <!-- 行2：全部分类标签 -->
  <div class="flex flex-wrap gap-1.5 text-[11px]">
    {
      catSlugs.map((c) => {
        const cc = categories.find((x) => x.slug === c);
        if (!cc) return null;
        return (
          <a
            href={localePath(locale, `/category/${c}`)}
            class="relative z-10 rounded-full border border-chip-border bg-chip px-2 py-0.5 text-ink-muted transition hover:border-violet-500/50 hover:text-ink"
          >
            {cc.emoji} {catLabel(c, cc.label, locale)}
          </a>
        );
      })
    }
  </div>

  <!-- 行3：一句话简介 -->
  <p class="line-clamp-2 text-sm text-ink-muted">{tool.oneLiner}</p>

  <!-- 行4：能力清单 -->
  {
    tool.capabilities && tool.capabilities.length > 0 && (
      <div class="flex flex-wrap gap-x-3 gap-y-1 text-[11px] text-ink-faint">
        {tool.capabilities.map((cap) => (
          <span>✦ {cap}</span>
        ))}
      </div>
    )
  }
</div>
