---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<Base locale={locale} title={`${t(locale, 'submit.h1')} — GameTools`}>
  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight">{t(locale, 'submit.h1')}</h1>
    <p class="mt-4 text-ink-muted">{t(locale, 'submit.p')}</p>

    <div class="mt-8 rounded-xl border border-edge bg-card p-6">
      <h2 class="font-semibold">{t(locale, 'submit.how')}</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-muted">
        <li>✅ {t(locale, 'submit.li1')}</li>
        <li>🏷️ {t(locale, 'submit.li2')}</li>
        <li>🧪 {t(locale, 'submit.li3')}</li>
      </ul>
    </div>

    <iframe
      data-tally-src="https://tally.so/embed/J1l48d?alignLeft=1&transparentBackground=1&dynamicHeight=1"
      loading="lazy"
      width="100%"
      height="420"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      title={t(locale, 'submit.h1')}
      class="mt-8 rounded-xl border border-edge"
    ></iframe>
    <script is:inline async src="https://tally.so/widgets/embed.js"></script>
  </div>
</Base>
