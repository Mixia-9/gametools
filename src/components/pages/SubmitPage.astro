---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<Base locale={locale} title={`${t(locale, 'submit.h1')} — GameTools`}>
  <div class="mx-auto max-w-2xl">
    <h1 class="text-3xl font-extrabold tracking-tight">{t(locale, 'submit.h1')}</h1>
    <p class="mt-4 text-ink-muted">{t(locale, 'submit.p')}</p>

    <div class="mt-8 rounded-xl border border-edge bg-card p-6">
      <h2 class="font-semibold">{t(locale, 'submit.how')}</h2>
      <ul class="mt-3 space-y-2 text-sm text-ink-muted">
        <li>✅ {t(locale, 'submit.li1')}</li>
        <li>🏷️ {t(locale, 'submit.li2')}</li>
        <li>🧪 {t(locale, 'submit.li3')}</li>
      </ul>
    </div>

    <!-- TODO: 替换为你的 Tally 表单（tally.so 免费建表，把 embed 代码贴到这里） -->
    <div class="mt-8 rounded-xl border border-dashed border-edge p-8 text-center text-sm text-ink-faint">
      {t(locale, 'submit.form')}
      <a href="mailto:you@example.com" class="text-violet-600 underline dark:text-violet-400">{t(locale, 'submit.email')}</a>
      {t(locale, 'submit.meanwhile')}
    </div>
  </div>
</Base>
