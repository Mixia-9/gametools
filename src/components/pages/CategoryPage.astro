---
import Base from '../../layouts/Base.astro';
import ToolCard from '../ToolCard.astro';
import GameFilter from '../GameFilter.astro';
import tools from '../../data/tools.json';
import { t, localePath, type Locale } from '../../i18n/ui';
import { inCategory, gameFirst } from '../../i18n/paths';
import { catLabel, catBlurb } from '../../i18n/categories';

interface Props {
  cat: { slug: string; label: string; emoji: string; blurb: string; searchRoot: string };
  locale?: Locale;
}

const { cat, locale = 'en' } = Astro.props;
// 专为游戏设计的工具排在前面
const list = gameFirst(tools.filter((tt) => inCategory(tt, cat.slug)));
const gameCount = list.filter((tt) => tt.focus === 'game').length;
const label = catLabel(cat.slug, cat.label, locale);
const blurb = catBlurb(cat.slug, cat.blurb, locale);
---

<Base locale={locale} title={`${label} — ${t(locale, 'title.catSuffix')}`} description={`${blurb} A curated list of ${list.length} AI tools for game developers.`}>
  <nav class="mb-6 text-sm text-ink-faint">
    <a href={localePath(locale, '/')} class="hover:text-ink">{locale === 'ja' ? 'ホーム' : locale.startsWith('zh') ? '首页' : 'Home'}</a>
    <span class="mx-1">/</span>
    <span class="text-ink-muted">{label}</span>
  </nav>

  <header class="mb-8">
    <h1 class="text-3xl font-extrabold tracking-tight">{cat.emoji} {t(locale, 'title.catSuffix')} · {label}</h1>
    <p class="mt-2 max-w-2xl text-ink-muted">{blurb}</p>
    <p class="mt-3 text-sm text-ink-faint">
      <span
        id="cat-count"
        data-total={list.length}
        data-all={t(locale, 'cat.tools', { n: list.length })}
        data-filtered={t(locale, 'cat.toolsFiltered', { n: list.length, shown: '__SHOWN__' })}>{t(locale, 'cat.tools', { n: list.length })}</span>
      · {t(locale, 'cat.also')} <span class="text-ink-muted">“{cat.searchRoot}”</span>
    </p>

    {gameCount > 0 && (
      <div class="mt-4 flex flex-wrap items-center gap-3">
        <GameFilter locale={locale} count={gameCount} />
        <span class="text-sm text-ink-faint">{t(locale, 'cat.sortNote')}</span>
      </div>
    )}
  </header>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {list.map((tool) => <ToolCard tool={tool} locale={locale} />)}
  </div>

  {list.length === 0 && (
    <p class="py-10 text-center text-ink-faint">
      {t(locale, 'home.empty')}
      <a href={localePath(locale, '/submit')} class="text-violet-600 underline dark:text-violet-400">{t(locale, 'home.submit')}</a>.
    </p>
  )}

  <p class="mt-10 text-sm text-ink-faint">
    <a href={localePath(locale, '/#categories')} class="text-violet-600 hover:underline dark:text-violet-400">{t(locale, 'cat.back')}</a>
  </p>

  <script>
    import { setupGameFilter, applyGameFilterFromUrl, isGameOnly } from '../../scripts/toolFilter';

    const cards = Array.from(document.querySelectorAll('[data-tool]'));
    const countEl = document.getElementById('cat-count');

    // “只看专为游戏”开关：隐藏通用工具，并更新计数
    const apply = () => {
      const on = isGameOnly();
      let shown = 0;
      for (const card of cards) {
        const hit = !on || card.getAttribute('data-focus') === 'game';
        card.classList.toggle('hidden', !hit);
        if (hit) shown++;
      }
      if (countEl) {
        const all = countEl.dataset.all ?? '';
        countEl.textContent =
          shown === Number(countEl.dataset.total) ? all : (countEl.dataset.filtered ?? '').replace('__SHOWN__', String(shown));
      }
    };

    setupGameFilter(apply);
    // 从开了筛选的首页点分类卡片进来（地址带 ?games=1）时，自动打开筛选
    applyGameFilterFromUrl();
  </script>
</Base>
