---
import Base from '../../layouts/Base.astro';
import { t, localePath, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<Base locale={locale} title={`${t(locale, 'about.h1')} — GameTools`}>
  <div class="mx-auto max-w-2xl space-y-6">
    <h1 class="text-3xl font-extrabold tracking-tight">{t(locale, 'about.h1')}</h1>

    <p class="text-ink-muted">{t(locale, 'about.p1')}</p>

    <ul class="space-y-3 text-ink-muted">
      <li><strong class="text-ink">{t(locale, 'about.li1s')}</strong> {t(locale, 'about.li1')}</li>
      <li><strong class="text-ink">{t(locale, 'about.li2s')}</strong> {t(locale, 'about.li2')}</li>
      <li><strong class="text-ink">{t(locale, 'about.li3s')}</strong> {t(locale, 'about.li3')}</li>
      <li><strong class="text-ink">{t(locale, 'about.li4s')}</strong> {t(locale, 'about.li4')}</li>
    </ul>

    <p class="text-ink-muted">
      {t(locale, 'about.p2')}
      <a href={localePath(locale, '/submit')} class="text-violet-600 underline dark:text-violet-400">{t(locale, 'about.cta')}</a>.
    </p>
  </div>
</Base>
