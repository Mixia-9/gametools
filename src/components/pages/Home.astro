---
import Base from '../../layouts/Base.astro';
import ToolCard from '../ToolCard.astro';
import CategoryCard from '../CategoryCard.astro';
import tools from '../../data/tools.json';
import categories from '../../data/categories.json';
import { t, localePath, type Locale } from '../../i18n/ui';
import { inCategory } from '../../i18n/paths';
import GameFilter from '../GameFilter.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const counts = Object.fromEntries(categories.map((c) => [c.slug, tools.filter((tt) => inCategory(tt, c.slug)).length]));
const gameCounts = Object.fromEntries(
  categories.map((c) => [c.slug, tools.filter((tt) => tt.focus === 'game' && inCategory(tt, c.slug)).length])
);
---

<Base locale={locale}>
  <section class="mb-12 text-center">
    <h1 class="mx-auto max-w-3xl text-4xl font-extrabold tracking-tight sm:text-5xl">
      {t(locale, 'hero.pre')}
      <span class="bg-gradient-to-r from-violet-600 to-cyan-600 bg-clip-text text-transparent dark:from-violet-400 dark:to-cyan-400">{t(locale, 'hero.post')}</span>
    </h1>
    <p class="mx-auto mt-4 max-w-2xl text-ink-muted">{t(locale, 'hero.sub')}</p>

    <div class="mx-auto mt-8 flex max-w-xl flex-col gap-3 sm:flex-row sm:items-center">
      <input
        id="search"
        type="search"
        placeholder={t(locale, 'search.ph', { n: tools.length })}
        class="w-full rounded-xl border border-edge bg-card px-4 py-3 text-ink placeholder-ink-faint outline-none focus:border-violet-500"
      />
      <GameFilter locale={locale} count={tools.filter((tt) => tt.focus === 'game').length} />
    </div>

    <p class="mt-3 text-sm text-ink-faint">
      <span id="tool-count">{tools.length}</span> {t(locale, 'stats.tools')} · <span id="cat-total">{categories.length}</span> {t(locale, 'stats.categories')} · {t(locale, 'stats.independent')}
    </p>
  </section>

  <section id="categories" class="mb-12 scroll-mt-20">
    <h2 class="mb-4 text-xl font-bold">{t(locale, 'home.browse')}</h2>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {categories.map((cat) => <CategoryCard cat={cat} count={counts[cat.slug] ?? 0} gameCount={gameCounts[cat.slug] ?? 0} locale={locale} />)}
    </div>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-bold">{t(locale, 'home.all')}</h2>
    <div id="tool-grid" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => <ToolCard tool={tool} locale={locale} />)}
    </div>
    <p id="empty" class="hidden py-10 text-center text-ink-faint">
      {t(locale, 'home.empty')}
      <a href={localePath(locale, '/submit')} class="text-violet-600 underline dark:text-violet-400">{t(locale, 'home.submit')}</a>.
    </p>
  </section>

  <!-- 自制小游戏入口 -->
  <section class="mt-12">
    <a
      href={localePath(locale, '/play')}
      class="flex flex-col items-center gap-4 rounded-2xl border border-edge bg-card p-8 text-center transition hover:border-violet-500/50 hover:bg-card-hover sm:flex-row sm:text-left"
    >
      <span class="text-4xl" aria-hidden="true">🧱</span>
      <span class="flex-1">
        <strong>{t(locale, 'play.card.title')}</strong>
        <span class="block text-sm text-ink-muted">{t(locale, 'play.card.text')}</span>
      </span>
      <span class="shrink-0 rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white">{t(locale, 'play.card.cta')} →</span>
    </a>
  </section>

  <script>
    import { setupGameFilter, applyGameFilterFromUrl, isGameOnly } from '../../scripts/toolFilter';

    const input = document.getElementById('search') as HTMLInputElement | null;
    const cards = Array.from(document.querySelectorAll('[data-tool]'));
    const catCards = Array.from(document.querySelectorAll('[data-cat]'));
    const countEl = document.getElementById('tool-count');
    const catTotalEl = document.getElementById('cat-total');
    const emptyEl = document.getElementById('empty');

    // 搜索关键词与“只看专为游戏”开关可以叠加；开关同时作用于“按任务浏览”的分类卡片
    const apply = () => {
      const v = input?.value.trim().toLowerCase() ?? '';
      const gameOnly = isGameOnly();
      let n = 0;
      for (const card of cards) {
        const hitSearch = !v || (card.getAttribute('data-search') ?? '').includes(v);
        const hit = hitSearch && (!gameOnly || card.getAttribute('data-focus') === 'game');
        card.classList.toggle('hidden', !hit);
        if (hit) n++;
      }
      if (countEl) countEl.textContent = String(n);
      emptyEl?.classList.toggle('hidden', n > 0);

      // 分类卡片：没有专为游戏工具的分类隐藏，数量改成“N 个中的 M 个”，链接带上筛选状态
      let cats = 0;
      for (const card of catCards) {
        const game = Number(card.getAttribute('data-game') ?? 0);
        const hit = !gameOnly || game > 0;
        card.classList.toggle('hidden', !hit);
        if (hit) cats++;
        const href = card.getAttribute('data-href') ?? '';
        card.setAttribute('href', gameOnly ? `${href}?games=1` : href);
        const chip = card.querySelector('[data-cat-count]');
        if (chip) {
          const filtered = (chip.getAttribute('data-filtered') ?? '').replace('__SHOWN__', String(game));
          chip.textContent = gameOnly ? `🎮 ${filtered}` : (chip.getAttribute('data-all') ?? '');
        }
      }
      if (catTotalEl) catTotalEl.textContent = String(cats);
    };

    setupGameFilter(apply);
    applyGameFilterFromUrl();
    input?.addEventListener('input', apply);
  </script>
</Base>
