---
import Base from '../../layouts/Base.astro';
import StackGame from '../games/StackGame.astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
---

<!-- 游戏页和“找工具”无关，不让搜索引擎收录 -->
<Base locale={locale} title={`${t(locale, 'play.title')} — GameTools`} description={t(locale, 'play.subtitle')} noindex>
  <div class="mx-auto max-w-xl">
    <h1 class="text-3xl font-extrabold tracking-tight">{t(locale, 'play.title')}</h1>
    <p class="mt-2 text-ink-muted">{t(locale, 'play.subtitle')}</p>

    <div class="mt-6">
      <StackGame locale={locale} />
    </div>

    <p class="mt-3 text-center text-sm text-ink-faint">{t(locale, 'play.made')}</p>
  </div>
</Base>
