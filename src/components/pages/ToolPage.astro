---
import Base from '../../layouts/Base.astro';
import ToolCard from '../ToolCard.astro';
import Comments from '../Comments.astro';
import FocusBadge from '../FocusBadge.astro';
import tools from '../../data/tools.json';
import categories from '../../data/categories.json';
import { t, localePath, type Locale } from '../../i18n/ui';
import { catLabel } from '../../i18n/categories';
import { toolSlug, inCategory } from '../../i18n/paths';

interface Tool {
  name: string;
  url: string;
  repo?: string;
  category: string;
  categories?: string[];
  capabilities?: string[];
  focus?: 'game' | 'general';
  pricing: string;
  engines: string[];
  tested: boolean;
  oneLiner: string;
  rating?: number;
  verdict?: string;
}

interface Props {
  tool: Tool;
  locale?: Locale;
}

const { tool, locale = 'en' } = Astro.props;
const cat = categories.find((c) => c.slug === tool.category);
const catLabelStr = cat ? catLabel(cat.slug, cat.label, locale) : '';
const similar = (tools as Tool[]).filter((tt) => tt.name !== tool.name && (tool.categories ?? [tool.category]).some((c) => inCategory(tt, c))).slice(0, 3);
const stars = tool.rating != null ? '★'.repeat(Math.round(tool.rating)) + '☆'.repeat(5 - Math.round(tool.rating)) : null;
const homeLabel = locale === 'ja' ? 'ホーム' : locale.startsWith('zh') ? '首页' : 'Home';
const priceStyles: Record<string, string> = {
  free: 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400',
  freemium: 'border-sky-500/30 bg-sky-500/10 text-sky-700 dark:text-sky-400',
  paid: 'border-amber-500/30 bg-amber-500/10 text-amber-700 dark:text-amber-400',
};
---

<Base locale={locale} title={`${tool.name} — ${catLabelStr} · ${t(locale, 'title.catSuffix')}`} description={tool.oneLiner}>
  <nav class="mb-6 text-sm text-ink-faint">
    <a href={localePath(locale, '/')} class="hover:text-ink">{homeLabel}</a> <span class="mx-1">/</span>
    <a href={localePath(locale, `/category/${cat?.slug}`)} class="hover:text-ink">{catLabelStr}</a> <span class="mx-1">/</span>
    <span class="text-ink-muted">{tool.name}</span>
  </nav>

  <header class="mb-8 flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-3xl font-extrabold tracking-tight">{tool.name}</h1>
      <span class={`rounded-full border px-2.5 py-1 text-xs ${tool.tested ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-700 dark:text-emerald-400' : 'border-chip-border bg-chip text-ink-muted'}`}>
        {tool.tested ? t(locale, 'tool.humanTested') : t(locale, 'tool.notTested')}
      </span>
      {tool.focus && <FocusBadge focus={tool.focus} locale={locale} size="md" />}
    </div>
    <div class="flex flex-wrap gap-2 text-sm">
      {
        (tool.categories ?? [tool.category]).map((c) => {
          const cc = categories.find((x) => x.slug === c);
          if (!cc) return null;
          return (
            <a
              href={localePath(locale, `/category/${c}`)}
              class="rounded-full border border-chip-border bg-chip px-3 py-1 text-ink-muted transition hover:border-violet-500/50 hover:text-ink"
            >
              {cc.emoji} {catLabel(c, cc.label, locale)}
            </a>
          );
        })
      }
    </div>

    <section class="flex flex-col gap-3">
      <h2 class="text-sm font-semibold uppercase tracking-wide text-ink-faint">{t(locale, 'tool.canDo')}</h2>
      <p class="max-w-2xl text-lg text-ink-muted">{tool.oneLiner}</p>
      {
        tool.capabilities && tool.capabilities.length > 0 && (
          <ul class="flex flex-col gap-1.5 text-sm text-ink-muted">
            {tool.capabilities.map((cap) => (
              <li class="flex items-start gap-2">
                <span class="mt-0.5 text-violet-500">✦</span>
                <span>{cap}</span>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <div class="flex flex-wrap gap-2 text-xs">
      <span class={`rounded-full border px-2.5 py-1 capitalize ${priceStyles[tool.pricing] ?? priceStyles.freemium}`}>{tool.pricing}</span>
      {tool.engines.map((e) => (
        <span class="rounded-full border border-chip-border bg-chip px-2.5 py-1 text-ink">{e === 'any' ? t(locale, 'card.any') : e}</span>
      ))}
    </div>

    {(stars || tool.verdict) && (
      <div class="max-w-2xl rounded-xl border border-edge bg-card p-4">
        <p class="flex items-center gap-2 text-sm font-semibold">
          <span>{t(locale, 'tool.curator')}</span>
          {stars && <span class="tracking-widest text-amber-500">{stars}</span>}
          {tool.rating != null && <span class="text-ink-faint">{tool.rating.toFixed(1)}/5</span>}
        </p>
        {tool.verdict && <p class="mt-2 text-sm text-ink-muted">{tool.verdict}</p>}
      </div>
    )}

    <div class="flex w-fit flex-wrap items-center gap-3">
      <a
        href={tool.url}
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="rounded-xl bg-violet-600 px-5 py-2.5 font-semibold text-white transition hover:bg-violet-500"
      >
        {t(locale, 'tool.visit', { n: tool.name })}
      </a>
      {tool.repo && (
        <a
          href={tool.repo}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-xl border border-edge px-5 py-2.5 font-semibold text-ink transition hover:border-violet-500/50"
        >
          GitHub ↗
        </a>
      )}
    </div>
  </header>

  {similar.length > 0 && (
    <section>
      <h2 class="mb-4 text-lg font-bold">{t(locale, 'tool.similar')} {catLabelStr}</h2>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {similar.map((tt) => <ToolCard tool={tt} locale={locale} />)}
      </div>
    </section>
  )}

  <Comments locale={locale} />

  <p class="mt-10 border-t border-edge pt-6 text-sm text-ink-faint">{t(locale, 'tool.policy')}</p>
</Base>
