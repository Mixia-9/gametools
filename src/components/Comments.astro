---
import { t, type Locale } from '../i18n/ui';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;

// Giscus 评论配置 —— 部署时填写（README 有完整步骤）：
// 1) GitHub 建公开仓库 → 2) 仓库 Settings 开启 Discussions
// 3) 安装 giscus app → 4) 到 https://giscus.app 生成下面四个值
const GISCUS = {
  repo: 'Mixia-9/gametools',
  repoId: 'R_kgDOVx-nKg',
  category: 'Announcements',
  categoryId: 'DIC_kwDOVx-nKs4DLazk',
};

const ready = Boolean(GISCUS.repo && GISCUS.repoId && GISCUS.categoryId);
---

<section id="comments" class="mt-12">
  <h2 class="mb-4 text-lg font-bold">{t(locale, 'comments.h')}</h2>

  {
    ready ? (
      <div class="giscus" />
    ) : (
      <div class="rounded-xl border border-dashed border-edge p-6 text-sm text-ink-faint">
        {t(locale, 'comments.fallback')}
      </div>
    )
  }

  {ready && (
    <div class="giscus"></div>
    <script
      is:inline
      define:vars={{ GISCUS, locale }}
    >
      // 动态创建 giscus 脚本：创建瞬间即写入与站点一致的主题，杜绝初始化竞态
      (function () {
        var s = document.createElement('script');
        s.src = 'https://giscus.app/client.js';
        s.async = true;
        s.crossOrigin = 'anonymous';
        var attrs = {
          'data-repo': GISCUS.repo,
          'data-repo-id': GISCUS.repoId,
          'data-category': GISCUS.category,
          'data-category-id': GISCUS.categoryId,
          'data-mapping': 'pathname',
          'data-strict': '0',
          'data-reactions-enabled': '1',
          'data-emit-metadata': '0',
          'data-input-position': 'top',
          'data-theme': document.documentElement.classList.contains('dark') ? 'dark' : 'light',
          'data-lang': locale,
        };
        Object.keys(attrs).forEach(function (k) {
          s.setAttribute(k, attrs[k]);
        });
        document.currentScript.parentElement.appendChild(s);
      })();
    </script>
  )}
</section>
